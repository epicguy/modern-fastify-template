{
  "name": "__TEMPLATE_REPO_NAME__",
  "version": "1.0.0",
  "description": "API server for the __TEMPLATE_REPO_NAME__ application",
  "main": "src/app.js",
  "scripts": {
    "e2e:local": "node e2e/e2eyaml.js start --var=host=localhost:8600 --var-from-file=e2e/vars* ",
    "e2e:local-all": "node e2e/e2eyaml.js start --var=host=localhost:8600 --var-from-file=e2e/vars* e2e/test-\\*",
    "dev": "nodemon --ignore e2e --ignore unit --ignore devops --inspect=0.0.0.0:8614 src/app.js | tee run.out",
    "local:dev": "nodemon -w package.json -w src --inspect=0.0.0.0:8614 src/app.js | tee logger/run.out",
    "start": "node src/app.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.779.0",
    "@aws-sdk/client-ses": "^3.699.0",
    "@aws-sdk/credential-providers": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.779.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.1",
    "@fastify/multipart": "^9.0.1",
    "axios": "^1.7.7",
    "fastify": "^5.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.1",
    "randomatic": "^3.1.1"
  },
  "devDependencies": {
    "chrono-node": "^2.7.7",
