{
  "family": "{{family}}-prod-td",
  "taskRoleArn": "arn:aws:iam::{{AWS_ACCOUNT}}:role/__TEMPLATE_PROJ_TAG__-app-ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::{{AWS_ACCOUNT}}:role/__TEMPLATE_PROJ_TAG__-app-ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": ".5 vCPU",
  "memory": "1GB",
  "containerDefinitions": [
    {
      "name": "__TEMPLATE_PROJ_TAG__-nodejs-api-prod",
      "image": "{{image}}",
      "environment": [
        {
          "name": "milieu",
          "value": "prod"
        },
        {
          "name": "image_tag",
          "value": "{{image_tag}}"
        }
      ],
      "secrets": [
        {
          "name": "milieu_private_key",
          "valueFrom": "arn:aws:ssm:us-east-1:{{AWS_ACCOUNT}}:parameter/__TEMPLATE_PROJ_TAG__-server/prod-env/key-for-env-vars"
        }
      ],
      "portMappings": [
        {
          "containerPort": 8600
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/{{family}}-prod-awslog",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "essential": true
    }
  ]
}
